ARCHS                                 = $(ARCHS_STANDARD_64_BIT)
ARCHS[sdk=iphonesimulator*]           = $(NATIVE_ARCH_ACTUAL)
MACOSX_DEPLOYMENT_TARGET[arch=x86_64] = 12.0
MACOSX_DEPLOYMENT_TARGET[arch=arm64]  = 12.0
ONLY_ACTIVE_ARCH                      = NO
SDKROOT                               = macosx
SUPPORTED_PLATFORMS                   = macosx
EXCLUDED_ARCHS                        = 

// Starting with Xcode 12, VALID_ARCHS is deprecated.
//
//VALID_ARCHS                           = $(ARCHS)

